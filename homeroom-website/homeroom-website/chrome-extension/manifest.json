{
  "manifest_version": 3,
  "name": "Homeroom Sync",
  "version": "1.1.0",
  "description": "Sends your assignment lists from Google Classroom, DeltaMath, VHL, Savvas, McGraw Hill, Pearson, AP Classroom and more to your Homeroom, using the sign-ins already in Chrome.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.deltamath.com/*",
    "https://*.vhlcentral.com/*",
    "https://*.savvasrealize.com/*",
    "https://*.savvas.com/*",
    "https://*.albert.io/*",
    "https://*.mheducation.com/*",
    "https://*.pearson.com/*",
    "https://*.collegeboard.org/*",
    "https://classroom.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://*.genesisedu.net/*",
    "https://*.genesisedu.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Homeroom Sync",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}